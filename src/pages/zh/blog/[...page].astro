---
import { getCollection } from 'astro:content';
import BlogIndex from '../../../views/BlogIndex.astro';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const entries = (await getCollection('postsZh')).sort((a, b) => b.data.date.localeCompare(a.data.date));
  const cats = (await getCollection('categories')).sort((a, b) => b.data.count - a.data.count);
  return paginate(entries, { pageSize: 18, props: { cats } });
}

const { page, cats } = Astro.props;
---

<BlogIndex lang="zh" posts={page.data} cats={cats} page={{ current: page.currentPage, total: page.lastPage, base: '/zh/blog/' }} />
