---
import { getCollection } from 'astro:content';
import BlogIndex from '../../../views/BlogIndex.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
  const PER = 20;
  const total = Math.ceil(posts.length / PER);
  return Array.from({ length: total }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { posts: posts.slice(i * PER, (i + 1) * PER), current: i + 1, total },
  }));
}

const { posts, current, total } = Astro.props;
---

<BlogIndex lang="zh" posts={posts} page={{ current, total, base: '/zh/blog/' }} />
