---
import { getCollection } from 'astro:content';
import ListingsIndex from '../../../views/ListingsIndex.astro';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const entries = (await getCollection('listingsZh')).sort((a, b) => a.data.title.localeCompare(b.data.title));
  const cats = (await getCollection('listingCategories'))
    .filter((c) => c.data.count > 0)
    .sort((a, b) => b.data.count - a.data.count);
  return paginate(entries, { pageSize: 18, props: { cats } });
}

const { page, cats } = Astro.props;
---

<ListingsIndex lang="zh" listings={page.data} cats={cats} page={{ current: page.currentPage, total: page.lastPage, base: '/zh/listings/' }} />
