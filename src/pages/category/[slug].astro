---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const cats = await getCollection('categories');
  return cats.map((c) => ({ params: { slug: c.id }, props: { cat: c } }));
}

const { cat } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => p.data.categories.includes(cat.id))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title={`${cat.data.name} | AIX Cove Blog`} description={`${cat.data.name} articles — AI tool reviews and guides.`}>
  <section class="section">
    <div class="breadcrumb"><a href="/blog/">Blog</a> / {cat.data.name}</div>
    <h1 style="font-size:1.9rem">{cat.data.name}</h1>
    <p style="color:var(--muted)">{posts.length} articles.</p>
    <div class="grid cols-3">
      {posts.map((p) => (
        <article class="card">
          {p.data.featured && <a href={`/${p.id}/`}><img class="thumb" src={p.data.featured} alt={p.data.title} loading="lazy" /></a>}
          <div class="body">
            <h3><a href={`/${p.id}/`}>{p.data.title}</a></h3>
            <p>{(p.data.description || '').slice(0, 130)}…</p>
            <div class="badges"><span class="badge">{p.data.date.slice(0, 10)}</span></div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
