---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  return listings.map((l) => ({ params: { slug: l.id }, props: { item: l } }));
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.data.title} — AI Tool Review | AIX Cove`} description={item.data.description} image={item.data.featured || undefined}>
  <article class="prose">
    <div class="breadcrumb"><a href="/listings/">AI Tools</a> / {item.data.categories[0]?.replace(/-/g, ' ')}</div>
    <h1>{item.data.title}</h1>
    <div class="meta">
      <span>Reviewed by AIX Cove</span>
      {item.data.date && <span> · <time datetime={item.data.date}>{item.data.date.slice(0, 10)}</time></span>}
    </div>
    {item.data.featured && <img class="hero-img" src={item.data.featured} alt={item.data.title} width="1200" height="630" />}
    <div class="badges">
      {item.data.categories.map((c) => <a class="badge" href={`/listing-category/${c}/`}>{c.replace(/-/g, ' ')}</a>)}
    </div>
    <div class="content" style="margin-top:20px" set:html={item.body} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: item.data.title,
      description: item.data.description,
      applicationCategory: 'AI Tool',
      image: item.data.featured ? new URL(item.data.featured, Astro.site).toString() : undefined,
      url: new URL(Astro.url.pathname, Astro.site).toString(),
      author: {
        '@type': 'Organization',
        name: 'AIX Cove',
        url: new URL('/', Astro.site).toString(),
      },
    })} />
  </article>
</BaseLayout>
