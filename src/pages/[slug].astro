---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catName } from '../i18n/ui';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const wpPages = (await getCollection('pages')).filter((p) => p.id !== 'home');
  const pageZhIds = new Set((await getCollection('pagesZh')).map((p) => p.id));
  return [
    ...posts.map((p) => ({ params: { slug: p.id }, props: { post: p, wpPage: undefined, hasZhPage: false } })),
    ...wpPages.map((p) => ({ params: { slug: p.id }, props: { post: undefined, wpPage: p, hasZhPage: pageZhIds.has(p.id) } })),
  ];
}

const { post, wpPage, hasZhPage } = Astro.props;
const entry = post ?? wpPage;
const { Content } = await render(entry);
---

<BaseLayout
  title={post ? `${post.data.title} | AIX Cove` : `${wpPage.data.title} | AIX Cove`}
  description={post?.data.description || undefined}
  image={post?.data.featured || undefined}
  altUrl={post ? `/zh/${post.id}/` : hasZhPage ? `/zh/${wpPage.id}/` : undefined}
>
  {post ? (
    <article class="prose">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date}>{post.data.date.slice(0, 10)}</time>
        <span> · By AIX Cove</span>
        {post.data.categories.length > 0 && (
          <span> · {post.data.categories.map((c) => <a href={`/category/${c}/`}>{catName('en', c, c)}</a>)}</span>
        )}
      </div>
      {post.data.featured && <img class="hero-img" src={post.data.featured} alt={post.data.title} width="1200" height="630" />}
      <div class="content"><Content /></div>
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.date,
        dateModified: post.data.modified || post.data.date,
        image: post.data.featured ? new URL(post.data.featured, Astro.site).toString() : undefined,
        author: { '@type': 'Organization', name: 'AIX Cove', url: new URL('/', Astro.site).toString() },
        publisher: { '@type': 'Organization', name: 'AIX Cove', url: new URL('/', Astro.site).toString() },
        mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
      })} />
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
          ...(post.data.categories.length > 0 ? [{
            '@type': 'ListItem', position: 2,
            name: catName('en', post.data.categories[0], post.data.categories[0]),
            item: new URL(`/category/${post.data.categories[0]}/`, Astro.site).toString(),
          }] : []),
          { '@type': 'ListItem', position: post.data.categories.length > 0 ? 3 : 2, name: post.data.title, item: new URL(Astro.url.pathname, Astro.site).toString() },
        ],
      })} />
    </article>
  ) : (
    <article class="prose">
      <h1>{wpPage.data.title}</h1>
      <div class="content"><Content /></div>
    </article>
  )}
</BaseLayout>
