---
import '../styles/global.css';
import { localeUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: 'en' | 'zh';
  altUrl?: string; // 对应语言的镜像页 URL（用于 hreflang 与切换器）
}

const {
  title,
  description,
  image,
  noindex = false,
  lang = 'en',
  altUrl,
} = Astro.props;

const L = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = altUrl ? new URL(altUrl, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {alt && <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alt} />}
    {alt && <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical} />}
    {alt && <link rel="alternate" hreflang="x-default" href={lang === 'zh' ? alt : canonical} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AIX Cove" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {alt && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={lang === 'zh' ? 'AIX Cove 中文' : 'AIX Cove'} href={lang === 'zh' ? '/zh/rss.xml' : '/rss.xml'} />
    <slot name="head" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('aix-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a href={localeUrl(lang, '/')} class="site-logo">AIX<span>Cove</span></a>
        <nav class="site-nav" id="site-nav">
          <a href={localeUrl(lang, '/listings/')}>{L.nav_tools}</a>
          <a href={localeUrl(lang, '/blog/')}>{L.nav_blog}</a>
          <a href={localeUrl(lang, '/search/')}>{L.nav_search}</a>
          <a href={localeUrl(lang, '/contact-us/')}>{L.nav_contact}</a>
        </nav>
        <div class="header-actions">
          {altUrl && (
            <a class="lang-switch" href={altUrl} hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>
              {L.switch_label}
            </a>
          )}
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark / light mode" title="Toggle dark / light mode">
            <span class="icon-moon">🌙</span><span class="icon-sun">☀️</span>
          </button>
          <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Menu" aria-expanded="false">
            <span class="bar"></span><span class="bar"></span><span class="bar"></span>
          </button>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function sync() {
          var light = document.documentElement.getAttribute('data-theme') === 'light';
          document.documentElement.classList.toggle('light-mode', light);
        }
        var nt = document.getElementById('nav-toggle');
        var nv = document.getElementById('site-nav');
        if (nt && nv) {
          nt.addEventListener('click', function () {
            var open = nv.classList.toggle('open');
            nt.classList.toggle('open', open);
            nt.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        btn.addEventListener('click', function () {
          var el = document.documentElement;
          var light = el.getAttribute('data-theme') === 'light';
          if (light) { el.removeAttribute('data-theme'); localStorage.setItem('aix-theme','dark'); }
          else { el.setAttribute('data-theme','light'); localStorage.setItem('aix-theme','light'); }
          sync();
        });
        sync();
      })();
    </script>
    <footer class="site-footer">
      <div class="container inner">
        <div>© {new Date().getFullYear()} AIX Cove · {L.footer_tag}</div>
        <div>
          <a href="/privacy-policy/">{L.footer_privacy}</a> · <a href="/terms-of-use/">{L.footer_terms}</a> · <a href={localeUrl(lang, '/contact-us/')}>{L.footer_contact}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
