---
import '../styles/global.css';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: 'en' | 'zh';
  altUrl?: string; // 对应语言的镜像页 URL（用于 hreflang 与切换器）
}

const {
  title,
  description,
  image,
  noindex = false,
  lang = 'en',
  altUrl,
} = Astro.props;

const L = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = altUrl ? new URL(altUrl, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {alt && <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alt} />}
    {alt && <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical} />}
    {alt && <link rel="alternate" hreflang="x-default" href={lang === 'zh' ? alt : canonical} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AIX Cove" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {alt && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AIX Cove" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a href={lang === 'zh' ? '/zh/' : '/'} class="site-logo">AIX<span>Cove</span></a>
        <nav class="site-nav">
          <a href={lang === 'zh' ? '/zh/listings/' : '/listings/'}>{L.nav_tools}</a>
          <a href={lang === 'zh' ? '/zh/blog/' : '/blog/'}>{L.nav_blog}</a>
          <a href={lang === 'zh' ? '/zh/search/' : '/search/'}>{L.nav_search}</a>
          <a href="/contact-us/">{L.nav_contact}</a>
        </nav>
        {alt && (
          <a class="lang-switch" href={alt} hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>
            {L.switch_label}
          </a>
        )}
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container inner">
        <div>© {new Date().getFullYear()} AIX Cove · {L.footer_tag}</div>
        <div>
          <a href="/privacy-policy/">{L.footer_privacy}</a> · <a href="/terms-of-use/">{L.footer_terms}</a> · <a href="/contact-us/">{L.footer_contact}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
