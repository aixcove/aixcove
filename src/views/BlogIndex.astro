---
// 博客列表视图（en/zh 共用，支持分页）
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui, catName } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
  posts: any[];
  cats?: any[];
  page?: { current: number; total: number; base: string; };
}

const { lang, posts, cats = [], page } = Astro.props;
const L = ui[lang];
const pg = page ?? { current: 1, total: 1, base: localeUrl(lang, '/blog/') };

const pageUrl = (n: number) => (n <= 1 ? `${pg.base}` : `${pg.base}${n}/`);
---

<BaseLayout
  title={pg.current > 1 ? `${L.blog_h1} - ${lang === 'zh' ? `第${pg.current}页` : `Page ${pg.current}`} | AIX Cove` : `${L.blog_h1} | AIX Cove`}
  description={L.blog_sub(posts.length)}
  lang={lang}
  altUrl={localeUrl(lang === 'zh' ? 'en' : 'zh', '/blog/')}
>
  <section class="section">
    <h1 style="font-size:1.9rem">{L.blog_h1}</h1>
    <p style="color:var(--muted)">{L.blog_sub(pg.total * 18 >= posts.length ? pg.total * 18 - (pg.total * 18 - posts.length) : posts.length)}</p>
    {cats.length > 0 && (
      <div class="chip-row">
        {cats.map((c) => (
          <a class="chip" href={localeUrl(lang, `/category/${c.id}/`)}>{catName(lang, c.id, c.data.name)}</a>
        ))}
      </div>
    )}
    {pg.current === 1 && (
      <nav class="featured-guides" aria-labelledby="featured-guides-heading">
        <h2 id="featured-guides-heading">{lang === 'zh' ? '精选指南：从你要做的事开始' : 'Featured guides: start with a task'}</h2>
        <ul>
          <li>
            <a href={localeUrl(lang, '/best-cursor-alternatives-in-2026-6-practical-picks/')}>
              {lang === 'zh' ? '想换掉 Cursor？' : 'Looking for a Cursor alternative?'}
            </a>
            {' '}{lang === 'zh' ? '按编辑器、终端和模型控制需求比较六种选择。' : 'Compare six options by editor, terminal workflow, and model control.'}
          </li>
          <li>
            <a href={localeUrl(lang, '/anythingllm-ollama-tutorial-build-a-local-ai-chatbot-in-2026/')}>
              {lang === 'zh' ? '用 AnythingLLM + Ollama 搭建私有文档聊天' : 'Build private document chat with AnythingLLM + Ollama'}
            </a>
            {' '}{lang === 'zh' ? '从小型文档集开始，配置本地模型与嵌入，再检查检索结果。' : 'Start with a small document set, configure local models and embeddings, then check retrieval.'}
          </li>
          <li>
            <a href={localeUrl(lang, '/how-to-use-dify-with-ollama-for-private-ai-workflows-in-2026/')}>
              {lang === 'zh' ? '用 Dify + Ollama 搭建本地 AI 工作流' : 'Build local AI workflows with Dify + Ollama'}
            </a>
            {' '}{lang === 'zh' ? '先跑通自托管部署与模型连接，再添加工作流和知识检索。' : 'Set up self-hosting and test the model connection before adding workflows and knowledge retrieval.'}
          </li>
        </ul>
      </nav>
    )}
    <div class="grid cols-3">
      {posts.map((p) => (
        <article class="card">
          {p.data.featured && <a href={localeUrl(lang, `/${p.id}/`)}><img class="thumb" src={p.data.featured} alt={p.data.title} loading="lazy" /></a>}
          <div class="body">
            <h3><a href={localeUrl(lang, `/${p.id}/`)}>{p.data.title}</a></h3>
            <p>{(p.data.description || '').slice(0, 130)}…</p>
            <div class="badges">
              <span class="badge">{p.data.date.slice(0, 10)}</span>
              {p.data.categories.slice(0, 1).map((c) => <span class="badge">{catName(lang, c, c)}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    {pg.total > 1 && (
      <nav class="pagination" aria-label="pagination">
        {pg.current > 1 && (
          <a class="page-link prev" href={pageUrl(pg.current - 1)}>
            {lang === 'zh' ? '← 上一页' : '← Previous'}
          </a>
        )}
        {Array.from({ length: pg.total }, (_, i) => i + 1).map((n) => (
          <a class={`page-link${n === pg.current ? ' active' : ''}`} href={pageUrl(n)} aria-current={n === pg.current ? 'page' : undefined}>
            {n}
          </a>
        ))}
        {pg.current < pg.total && (
          <a class="page-link next" href={pageUrl(pg.current + 1)}>
            {lang === 'zh' ? '下一页 →' : 'Next →'}
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>

<style>
  .featured-guides { margin: 1.5rem 0; padding: 1rem 1.25rem; border: 1px solid var(--border); border-radius: 12px; }
  .featured-guides h2 { margin: 0 0 .75rem; font-size: 1.15rem; }
  .featured-guides ul { margin: 0; padding-left: 1.25rem; }
  .featured-guides li { line-height: 1.6; }
  .featured-guides li + li { margin-top: .65rem; }
  .featured-guides a { text-decoration: underline; text-underline-offset: .15em; }
</style>
