---
// 博客列表视图（en/zh 共用，支持分页）
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui, catName } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
  posts: any[];
  cats?: any[];
  page?: { current: number; total: number; base: string; };
}

const { lang, posts, cats = [], page } = Astro.props;
const L = ui[lang];
const prefix = localeUrl(lang, '');
const pg = page ?? { current: 1, total: 1, base: `${prefix}/blog/` };

const pageUrl = (n: number) => (n <= 1 ? `${pg.base}` : `${pg.base}${n}/`);
---

<BaseLayout
  title={pg.current > 1 ? `${L.blog_h1} - ${lang === 'zh' ? `第${pg.current}页` : `Page ${pg.current}`} | AIX Cove` : `${L.blog_h1} | AIX Cove`}
  description={L.blog_sub(posts.length)}
  lang={lang}
  altUrl={localeUrl(lang === 'zh' ? 'en' : 'zh', '/blog/')}
>
  <section class="section">
    <h1 style="font-size:1.9rem">{L.blog_h1}</h1>
    <p style="color:var(--muted)">{L.blog_sub(pg.total * 18 >= posts.length ? pg.total * 18 - (pg.total * 18 - posts.length) : posts.length)}</p>
    {cats.length > 0 && (
      <div class="chip-row">
        {cats.map((c) => (
          <a class="chip" href={`${prefix}/category/${c.id}/`}>{catName(lang, c.id, c.data.name)}</a>
        ))}
      </div>
    )}
    <div class="grid cols-3">
      {posts.map((p) => (
        <article class="card">
          {p.data.featured && <a href={`${prefix}/${p.id}/`}><img class="thumb" src={p.data.featured} alt={p.data.title} loading="lazy" /></a>}
          <div class="body">
            <h3><a href={`${prefix}/${p.id}/`}>{p.data.title}</a></h3>
            <p>{(p.data.description || '').slice(0, 130)}…</p>
            <div class="badges">
              <span class="badge">{p.data.date.slice(0, 10)}</span>
              {p.data.categories.slice(0, 1).map((c) => <span class="badge">{catName(lang, c, c)}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    {pg.total > 1 && (
      <nav class="pagination" aria-label="pagination">
        {pg.current > 1 && (
          <a class="page-link prev" href={pageUrl(pg.current - 1)}>
            {lang === 'zh' ? '← 上一页' : '← Previous'}
          </a>
        )}
        {Array.from({ length: pg.total }, (_, i) => i + 1).map((n) => (
          <a class={`page-link${n === pg.current ? ' active' : ''}`} href={pageUrl(n)} aria-current={n === pg.current ? 'page' : undefined}>
            {n}
          </a>
        ))}
        {pg.current < pg.total && (
          <a class="page-link next" href={pageUrl(pg.current + 1)}>
            {lang === 'zh' ? '下一页 →' : 'Next →'}
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
