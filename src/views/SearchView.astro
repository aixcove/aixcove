---
// 搜索视图（en/zh 共用）
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
}
const { lang } = Astro.props;
const L = ui[lang];
---

<BaseLayout title={L.search_title} description={L.search_desc} noindex lang={lang} altUrl={localeUrl(lang, '/search/')}>
  <div class="pagefind-wrap">
    <h1 style="font-size:1.9rem">{L.nav_search}</h1>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search).get('q') || '';
        var s = document.createElement('script');
        s.src = '/pagefind/pagefind-ui.js';
        s.onload = function () {
          var ui = new window.PagefindUI({
            element: '#search',
            showImages: true,
            showSubResults: true,
          });
          if (q) ui.triggerSearch(q);
        };
        document.head.appendChild(s);
      })();
    </script>
  </div>
</BaseLayout>
