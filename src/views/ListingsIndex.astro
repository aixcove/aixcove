---
// 工具目录视图（en/zh 共用，支持分页）
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui, catName } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
  listings: any[];
  cats: any[];
  page?: { current: number; total: number; base: string; };
}

const { lang, listings, cats, page } = Astro.props;
const L = ui[lang];
const prefix = localeUrl(lang, '');
const pg = page ?? { current: 1, total: 1, base: `${prefix}/listings/` };

const pageUrl = (n: number) => (n <= 1 ? `${pg.base}` : `${pg.base}${n}/`);
---

<BaseLayout
  title={pg.current > 1 ? `${L.tools_h1} - ${lang === 'zh' ? `第${pg.current}页` : `Page ${pg.current}`} | AIX Cove` : `${L.tools_h1} | AIX Cove`}
  description={L.tools_sub(listings.length)}
  lang={lang}
  altUrl={localeUrl(lang === 'zh' ? 'en' : 'zh', '/listings/')}
>
  <section class="section">
    <h1 style="font-size:1.9rem">{L.tools_h1}</h1>
    <p style="color:var(--muted)">{L.tools_sub(listings.length)}</p>
    {cats.length > 0 && (
      <div class="chip-row">
        {cats.map((c) => (
          <a class="chip" href={`${prefix}/listing-category/${c.data.slug}/`}>{catName(lang, c.data.slug, c.data.name)}</a>
        ))}
      </div>
    )}
    <div class="grid cols-3">
      {listings.map((l) => (
        <article class="card">
          {l.data.featured && <a href={`${prefix}/listing/${l.id}/`}><img class="thumb" src={l.data.featured} alt={l.data.title} loading="lazy" /></a>}
          <div class="body">
            <h3><a href={`${prefix}/listing/${l.id}/`}>{lang === 'zh' && l.data.titleZh ? l.data.titleZh : l.data.title}</a></h3>
            <p>{(lang === 'zh' && l.data.descriptionZh ? l.data.descriptionZh : l.data.description).slice(0, 130)}…</p>
          </div>
        </article>
      ))}
    </div>

    {pg.total > 1 && (
      <nav class="pagination" aria-label="pagination">
        {pg.current > 1 && (
          <a class="page-link prev" href={pageUrl(pg.current - 1)}>
            {lang === 'zh' ? '← 上一页' : '← Previous'}
          </a>
        )}
        {Array.from({ length: pg.total }, (_, i) => i + 1).map((n) => (
          <a class={`page-link${n === pg.current ? ' active' : ''}`} href={pageUrl(n)} aria-current={n === pg.current ? 'page' : undefined}>
            {n}
          </a>
        ))}
        {pg.current < pg.total && (
          <a class="page-link next" href={pageUrl(pg.current + 1)}>
            {lang === 'zh' ? '下一页 →' : 'Next →'}
          </a>
        )}
      </nav>
    )}
  </section>
</BaseLayout>
