---
// 工具详情视图（en/zh 共用）
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui, catName } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
  item: any;
}
const { lang, item } = Astro.props;
const L = ui[lang];
const prefix = localeUrl(lang, '');
const title = item.data.title;
const description = item.data.description;
const breadcrumbCat = item.data.categories[0] ? catName(lang, item.data.categories[0], item.data.categories[0]) : '';
const { Content } = await render(item);
---

<BaseLayout
  title={`${title} — ${lang === 'zh' ? 'AI 工具评测' : 'AI Tool Review'} | AIX Cove`}
  description={description}
  image={item.data.image || undefined}
  lang={lang}
  altUrl={lang === 'zh' ? `/listing/${item.id}/` : `/zh/listing/${item.id}/`}
>
  <article class="prose">
    <div class="breadcrumb"><a href={`${prefix}/listings/`}>{L.nav_tools}</a> / {breadcrumbCat}</div>
    <h1>{title}</h1>
    <div class="meta">
      <span>{L.reviewed_by}</span>
      {item.data.date && <span> · <time datetime={item.data.date}>{item.data.date.slice(0, 10)}</time></span>}
    </div>
    {item.data.image && <img class="hero-img" src={item.data.image} alt={title} width="1200" height="630" />}
    {item.data.featured && <span class="featured-badge">{lang === 'zh' ? '精选工具' : 'Featured tool'}</span>}
    <div class="badges">
      {item.data.categories.map((c) => <a class="badge" href={`${prefix}/listing-category/${c}/`}>{catName(lang, c, c)}</a>)}
    </div>
    <div class="content" style="margin-top:20px"><Content /></div>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: title,
      description: description,
      applicationCategory: 'AI Tool',
      inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
      image: item.data.image ? new URL(item.data.image, Astro.site).toString() : undefined,
      url: new URL(Astro.url.pathname, Astro.site).toString(),
      author: {
        '@type': 'Organization',
        name: 'AIX Cove',
        url: new URL('/', Astro.site).toString(),
      },
    })} />
  </article>
</BaseLayout>
