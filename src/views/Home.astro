---
// 首页视图（en/zh 共用）
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui, catName } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
  posts: any[];
  listings: any[];
  listCats: any[];
}
const { lang, posts, listings, listCats } = Astro.props;
const L = ui[lang];
const prefix = localeUrl(lang, '');
const latestPosts = posts.slice(0, 6);
const latestListings = [...listings].sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 9);
const siteUrl = new URL(prefix, Astro.site).toString();
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AIX Cove',
  url: siteUrl,
  description: lang === 'zh'
    ? 'AIX Cove — 精选 AI 工具目录与评测。'
    : 'AIX Cove — curated AI tools directory and reviews.',
};
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AIX Cove',
  url: siteUrl,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL(`search/?q={search_term_string}`, new URL(prefix, Astro.site)).toString(),
    'query-input': 'required name=search_term_string',
  },
};
const altUrl = localeUrl(lang === 'zh' ? 'en' : 'zh', '/');
---

<BaseLayout
  title={L.home_title}
  description={L.hero_p}
  image="/uploads/2026/04/cropped-banner-scaled-1.jpg"
  lang={lang}
  altUrl={altUrl}
>
  <section class="hero">
    <h1>{L.hero_h1}</h1>
    <p>{L.hero_p}</p>
    <form class="search-box" action={`${prefix}/search/`} method="get">
      <input type="search" name="q" placeholder={L.search_placeholder} aria-label={L.search_btn} />
      <button type="submit">{L.search_btn}</button>
    </form>
  </section>

  <section class="section">
    <h2>{L.explore_categories}</h2>
    <div class="badges" style="justify-content:center">
      {listCats.slice(0, 18).map((c) => (
        <a class="badge" href={`${prefix}/listing-category/${c.id}/`}>{catName(lang, c.id, c.data.name)}</a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>{L.latest_tools}</h2>
    <div class="grid cols-3">
      {latestListings.map((l) => (
        <article class:list={['card', { 'is-featured': l.data.featured }]}>
          {l.data.featured && <span class="featured-badge">{lang === 'zh' ? '精选工具' : 'Featured tool'}</span>}
          {l.data.image && <a href={`${prefix}/listing/${l.id}/`}><img class="thumb" src={l.data.image} alt={l.data.title} loading="lazy" /></a>}
          <div class="body">
            <h3><a href={`${prefix}/listing/${l.id}/`}>{l.data.title}</a></h3>
            <p>{l.data.description.slice(0, 120)}…</p>
            <div class="badges">
              {l.data.categories.slice(0, 2).map((c) => <span class="badge">{catName(lang, c, c)}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
    <p style="text-align:center;margin-top:24px"><a class="more-link" href={`${prefix}/listings/`}>{L.browse_all(listings.length)}</a></p>
  </section>

  <section class="section">
    <h2>{L.from_blog}</h2>
    <div class="grid cols-3">
      {latestPosts.map((p) => (
        <article class="card">
          {p.data.featured && <a href={`${prefix}/${p.id}/`}><img class="thumb" src={p.data.featured} alt={p.data.title} loading="lazy" /></a>}
          <div class="body">
            <h3><a href={`${prefix}/${p.id}/`}>{p.data.title}</a></h3>
            <p>{(p.data.description || '').slice(0, 120)}…</p>
          </div>
        </article>
      ))}
    </div>
    <p style="text-align:center;margin-top:24px"><a class="more-link" href={`${prefix}/blog/`}>{L.all_articles}</a></p>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
</BaseLayout>
