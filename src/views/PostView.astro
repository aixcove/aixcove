---
// 文章详情视图（en/zh 共用；每种语言各自使用 Astro Content collection）
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeUrl } from '../i18n/utils';
import { ui, catName } from '../i18n/ui';

interface Props {
  lang: 'en' | 'zh';
  post: any;
}
const { lang, post } = Astro.props;
const L = ui[lang];
const title = post.data.title;
const description = post.data.description;
const { Content } = await render(post);
---

<BaseLayout title={`${title} | AIX Cove`} description={description} image={post.data.featured || undefined} lang={lang} altUrl={lang === 'zh' ? `/${post.id}/` : `/zh/${post.id}/`}>
  <article class="prose">
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={post.data.date}>{post.data.date.slice(0, 10)}</time>
      <span> · {post.data.author ? `By ${post.data.author}` : L.by_author}</span>
      <span> · {L.reviewed_by}</span>
      {post.data.categories.length > 0 && (
        <span> · {post.data.categories.map((c) => <a href={localeUrl(lang, `/category/${c}/`)}>{catName(lang, c, c)}</a>)}</span>
      )}
    </div>
    {post.data.featured && <img class="hero-img" src={post.data.featured} alt={title} width="1200" height="630" />}
    <div class="content"><Content /></div>
    <div class="source-note">{L.source_line}</div>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
      datePublished: post.data.date,
      dateModified: post.data.modified || post.data.date,
      image: post.data.featured ? new URL(post.data.featured, Astro.site).toString() : undefined,
      author: post.data.author ? {
        '@type': 'Person',
        name: post.data.author,
        url: new URL('/', Astro.site).toString(),
      } : {
        '@type': 'Organization',
        name: 'AIX Cove',
        url: new URL('/', Astro.site).toString(),
      },
      publisher: {
        '@type': 'Organization',
        name: 'AIX Cove',
        url: new URL('/', Astro.site).toString(),
      },
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: lang === 'zh' ? '首页' : 'Home', item: new URL(lang === 'zh' ? '/zh/' : '/', Astro.site).toString() },
        ...(post.data.categories.length > 0 ? [{
          '@type': 'ListItem', position: 2,
          name: catName(lang, post.data.categories[0], post.data.categories[0]),
          item: new URL(localeUrl(lang, `/category/${post.data.categories[0]}/`), Astro.site).toString(),
        }] : []),
        { '@type': 'ListItem', position: post.data.categories.length > 0 ? 3 : 2, name: title, item: new URL(Astro.url.pathname, Astro.site).toString() },
      ],
    })} />
  </article>
</BaseLayout>
